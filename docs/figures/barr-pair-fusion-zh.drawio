aHei;fontSize=23;strokeWidth=1.5;fontColor=#20252A;spacing=9;rounded=0;fillColor=#ffffff;strokeColor=#555C63;" vertex="1" parent="screen"><mxGeometry as="geometry" x="140" y="270" width="420" height="105" /></mxCell><mxCell id="deficits" value="缺口 &lt;i&gt;d&lt;/i&gt;&lt;sub&gt;v&lt;/sub&gt; = &lt;i&gt;W&lt;/i&gt;(&lt;i&gt;B&lt;/i&gt;&lt;sub&gt;v&lt;/sub&gt;) − &lt;i&gt;w&lt;/i&gt;&lt;sub&gt;v&lt;/sub&gt;&lt;br&gt;保留正单点见证" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=23;strokeWidth=1.5;fontColor=#20252A;spacing=9;rounded=0;fillColor=#ffffff;strokeColor=#555C63;" vertex="1" parent="screen"><mxGeometry as="geometry" x="140" y="430" width="420" height="95" /></mxCell><mxCell id="seed_init" value="轮换全部 seed 次序；游标 &lt;i&gt;j&lt;/i&gt; ← 0&lt;br&gt;初始化 pair 游标与去重戳" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=23;strokeWidth=1.5;fontColor=#20252A;spacing=9;rounded=0;fillColor=#ffffff;strokeColor=#555C63;" vertex="1" parent="screen"><mxGeometry as="geometry" x="140" y="570" width="420" height="80" /></mxCell><mxCell id="scan_loop" value="&lt;i&gt;j &amp;lt; n&lt;/i&gt;&lt;sub&gt;seed&lt;/sub&gt; 且&lt;br&gt;尚未到达 deadline？" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=23;strokeWidth=1.5;fontColor=#20252A;spacing=9;rhombus;fillColor=#ffffff;strokeColor=#555C63;" vertex="1" parent="screen"><mxGeometry as="geometry" x="185" y="705" width="330" height="125" /></mxCell><mxCell id="enumerate" value="取下一个共享阻塞 pair&lt;br&gt;二跳枚举、去重；仅取 &lt;i&gt;a &amp;lt; b&lt;/i&gt;" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=23;strokeWidth=1.5;fontColor=#20252A;spacing=9;rounded=0;fillColor=#ffffff;strokeColor=#555C63;" vertex="1" parent="screen"><mxGeometry as="geometry" x="140" y="895" width="420" height="100" /></mxCell><mxCell id="prune" value="外部点互不冲突&lt;br&gt;且 &lt;i&gt;U&lt;/i&gt;&lt;sub&gt;ab&lt;/sub&gt; &amp;gt; 0？" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=23;strokeWidth=1.5;fontColor=#20252A;spacing=9;rhombus;fillColor=#E8F1EF;strokeColor=#356D70;" vertex="1" parent="screen"><mxGeometry as="geometry" x="185" y="1050" width="330" height="120" /></mxCell><mxCell id="exact" value="&lt;b&gt;精确共享阻塞增益&lt;/b&gt;&lt;br&gt;&lt;i&gt;g&lt;/i&gt;&lt;sub&gt;ab&lt;/sub&gt; = &lt;i&gt;W&lt;/i&gt;(&lt;i&gt;B&lt;/i&gt;&lt;sub&gt;a&lt;/sub&gt; ∩ &lt;i&gt;B&lt;/i&gt;&lt;sub&gt;b&lt;/sub&gt;) − &lt;i&gt;d&lt;/i&gt;&lt;sub&gt;a&lt;/sub&gt; − &lt;i&gt;d&lt;/i&gt;&lt;sub&gt;b&lt;/sub&gt;" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=23;strokeWidth=1.5;fontColor=#20252A;spacing=9;rounded=0;fillColor=#E8F1EF;strokeColor=#356D70;" vertex="1" parent="screen"><mxGeometry as="geometry" x="125" y="1230" width="450" height="105" /></mxCell><mxCell id="retain_next" value="保留当前最大正见证&lt;br&gt;推进 pair / seed 游标" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=23;strokeWidth=1.5;fontColor=#20252A;spacing=9;rounded=0;fillColor=#E8F1EF;strokeColor=#356D70;" vertex="1" parent="screen"><mxGeometry as="geometry" x="140" y="1395" width="420" height="95" /></mxCell><mxCell id="completion" value="全 seed 覆盖且单点均非正：complete ≤ 2&lt;br&gt;另无正见证：完整零证书&lt;br&gt;deadline 中断：partial" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=23;strokeWidth=1.5;fontColor=#20252A;spacing=9;rounded=0;fillColor=#E8F1EF;strokeColor=#356D70;fontSize=21;" vertex="1" parent="screen"><mxGeometry as="geometry" x="110" y="1620" width="480" height="120" /></mxCell><mxCell id="screen_return" value="返回 &lt;i&gt;T,g&lt;/i&gt; 与完整性标志" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=23;strokeWidth=1.5;fontColor=#20252A;spacing=9;shape=parallelogram;perimeter=parallelogramPerimeter;fillColor=#ffffff;strokeColor=#555C63;" vertex="1" parent="screen"><mxGeometry as="geometry" x="140" y="1800" width="420" height="85" /></mxCell><mxCell id="scope" value="&lt;b&gt;解析上界与证书范围&lt;/b&gt;&lt;br&gt;&lt;i&gt;U&lt;/i&gt;&lt;sub&gt;ab&lt;/sub&gt; = min(&lt;i&gt;W&lt;/i&gt;(&lt;i&gt;B&lt;/i&gt;&lt;sub&gt;a&lt;/sub&gt;), &lt;i&gt;W&lt;/i&gt;(&lt;i&gt;B&lt;/i&gt;&lt;sub&gt;b&lt;/sub&gt;)) − &lt;i&gt;d&lt;/i&gt;&lt;sub&gt;a&lt;/sub&gt; − &lt;i&gt;d&lt;/i&gt;&lt;sub&gt;b&lt;/sub&gt;&lt;br&gt;零证书仅覆盖此状态的至多二点插入交换&lt;br&gt;partial 的零见证不能形成完整零证书" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=23;strokeWidth=1.5;fontColor=#20252A;spacing=9;rounded=0;fillColor=#E8F1EF;strokeColor=#356D70;fontSize=21;" vertex="1" parent="screen"><mxGeometry as="geometry" x="60" y="2030" width="580" height="165" /></mxCell><mxCell id="s0" value="" edge="1" parent="screen" source="screen_input" target="lists" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#353A40;strokeWidth=1.6;fontFamily=Microsoft YaHei;fontSize=20;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=9;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s1" value="" edge="1" parent="screen" source="lists" target="deficits" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#353A40;strokeWidth=1.6;fontFamily=Microsoft YaHei;fontSize=20;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=9;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s2" value="" edge="1" parent="screen" source="deficits" target="seed_init" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#353A40;strokeWidth=1.6;fontFamily=Microsoft YaHei;fontSize=20;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=9;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s3" value="" edge="1" parent="screen" source="seed_init" target="scan_loop" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#353A40;strokeWidth=1.6;fontFamily=Microsoft YaHei;fontSize=20;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=9;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s4" value="是" edge="1" parent="screen" source="scan_loop" target="enumerate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#353A40;strokeWidth=1.6;fontFamily=Microsoft YaHei;fontSize=20;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=9;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s5" value="" edge="1" parent="screen" source="enumerate" target="prune" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#353A40;strokeWidth=1.6;fontFamily=Microsoft YaHei;fontSize=20;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=9;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s6" value="是" edge="1" parent="screen" source="prune" target="exact" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#353A40;strokeWidth=1.6;fontFamily=Microsoft YaHei;fontSize=20;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=9;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s7" value="" edge="1" parent="screen" source="exact" target="retain_next" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#353A40;strokeWidth=1.6;fontFamily=Microsoft YaHei;fontSize=20;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=9;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s8" value="" edge="1" parent="screen" source="completion" target="screen_return" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#353A40;strokeWidth=1.6;fontFamily=Microsoft YaHei;fontSize=20;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=9;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="screen_loop_back" value="下一 pair / seed" edge="1" parent="screen" source="retain_next" target="scan_loop" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#353A40;strokeWidth=1.6;fontFamily=Microsoft YaHei;fontSize=20;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=9;exitX=0.5;exitY=1;entryX=0;entryY=0.5;"><mxGeometry as="geometry" relative="1" x="-0.7" y="0"><Array as="points"><mxPoint x="350" y="1535" /><mxPoint x="45" y="1535" /><mxPoint x="45" y="767.5" /></Array></mxGeometry></mxCell><mxCell id="s_prune_no" value="否" edge="1" parent="screen" source="prune" target="retain_next" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#353A40;strokeWidth=1.6;fontFamily=Microsoft YaHei;fontSize=20;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=9;exitX=1;exitY=0.5;entryX=1;entryY=0.5;"><mxGeometry as="geometry" relative="1" x="-0.9" y="0"><Array as="points"><mxPoint x="620" y="1110" /><mxPoint x="620" y="1442.5" /></Array></mxGeometry></mxCell><mxCell id="s_finished" value="否" edge="1" parent="screen" source="scan_loop" target="completion" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#353A40;strokeWidth=1.6;fontFamily=Microsoft YaHei;fontSize=20;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=9;exitX=1;exitY=0.5;entryX=1;entryY=0.5;"><mxGeometry as="geometry" relative="1" x="-0.9" y="0"><Array as="points"><mxPoint x="670" y="767.5" /><mxPoint x="670" y="1680" /></Array></mxGeometry></mxCell><mxCell id="recovery_input" value="输入 &lt;i&gt;S,T,S&lt;/i&gt;&lt;sub&gt;T&lt;/sub&gt;&lt;i&gt;,D&lt;/i&gt;&lt;br&gt;正见证已先送入归档" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=23;strokeWidth=1.5;fontColor=#20252A;spacing=9;shape=parallelogram;perimeter=parallelogramPerimeter;fillColor=#F0ECF3;strokeColor=#756484;" vertex="1" parent="recovery"><mxGeometry as="geometry" x="140" y="110" width="420" height="85" /></mxCell><mxCell id="expand" value="沿已支付阻塞点扩展&lt;br&gt;保留负单点候选" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=23;strokeWidth=1.5;fontColor=#20252A;spacing=9;rounded=0;fillColor=#ffffff;strokeColor=#555C63;" vertex="1" parent="recovery"><mxGeometry as="geometry" x="140" y="280" width="420" height="115" /></mxCell><mxCell id="sketch" value="&lt;b&gt;clique 成本分摊上界&lt;/b&gt;&lt;br&gt;与可行 sketch 下界见证" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=23;strokeWidth=1.5;fontColor=#20252A;spacing=9;rounded=0;fillColor=#F0ECF3;strokeColor=#756484;" vertex="1" parent="recovery"><mxGeometry as="geometry" x="140" y="460" width="420" height="115" /></mxCell><mxCell id="need" value="&lt;i&gt;U&lt;/i&gt; &amp;gt; 已有增益&lt;br&gt;且尚有时间？" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=23;strokeWidth=1.5;fontColor=#20252A;spacing=9;rhombus;fillColor=#ffffff;strokeColor=#555C63;" vertex="1" parent="recovery"><mxGeometry as="geometry" x="185" y="645" width="330" height="125" /></mxCell><mxCell id="kernel" value="&lt;b&gt;完整边界 Kernel&lt;/b&gt;&lt;br&gt;外部点 + 全部受影响分量&lt;br&gt;尺寸超限不截断边界" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=23;strokeWidth=1.5;fontColor=#20252A;spacing=9;rounded=0;fillColor=#F0ECF3;strokeColor=#756484;" vertex="1" parent="recovery"><mxGeometry as="geometry" x="140" y="850" width="420" height="115" /></mxCell><mxCell id="factor" value="&lt;b&gt;响应因子 + 结构消元&lt;/b&gt;&lt;br&gt;遵守宽度、边界与表项上限" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=23;strokeWidth=1.5;fontColor=#20252A;spacing=9;rounded=0;fillColor=#F0ECF3;strokeColor=#756484;" vertex="1" parent="recovery"><mxGeometry as="geometry" x="140" y="1035" width="420" height="115" /></mxCell><mxCell id="fallback" value="未决时：有界分支&lt;br&gt;必要时使用可行回退" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=23;strokeWidth=1.5;fontColor=#20252A;spacing=9;rounded=0;fillColor=#ffffff;strokeColor=#555C63;" vertex="1" parent="recovery"><mxGeometry as="geometry" x="140" y="1220" width="420" height="95" /></mxCell><mxCell id="lift" value="lift 后在完整图上核验&lt;br&gt;仅保留超过当前见证的额外增益" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=23;strokeWidth=1.5;fontColor=#20252A;spacing=9;rounded=0;fillColor=#F0ECF3;strokeColor=#756484;" vertex="1" parent="recovery"><mxGeometry as="geometry" x="140" y="1395" width="420" height="110" /></mxCell><mxCell id="keep" value="保留当前最佳已核验候选&lt;br&gt;deadline / 尺寸超限时同样保留" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=23;strokeWidth=1.5;fontColor=#20252A;spacing=9;rounded=0;fillColor=#ffffff;strokeColor=#555C63;" vertex="1" parent="recovery"><mxGeometry as="geometry" x="140" y="1605" width="420" height="95" /></mxCell><mxCell id="recovery_return" value="返回已保留的可行候选 Ŝ" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=23;strokeWidth=1.5;fontColor=#20252A;spacing=9;shape=parallelogram;perimeter=parallelogramPerimeter;fillColor=#ffffff;strokeColor=#555C63;" vertex="1" parent="recovery"><mxGeometry as="geometry" x="140" y="1800" width="420" height="85" /></mxCell><mxCell id="objective" value="&lt;b&gt;固定状态上的联合交换&lt;/b&gt;&lt;br&gt;&lt;i&gt;S&lt;/i&gt;&lt;sub&gt;T&lt;/sub&gt; = (&lt;i&gt;S&lt;/i&gt; ∖ &lt;i&gt;B&lt;/i&gt;(&lt;i&gt;T&lt;/i&gt;)) ∪ &lt;i&gt;T&lt;/i&gt;&lt;br&gt;&lt;i&gt;g&lt;/i&gt;&lt;sub&gt;S&lt;/sub&gt;(&lt;i&gt;T&lt;/i&gt;) = &lt;i&gt;W&lt;/i&gt;(&lt;i&gt;T&lt;/i&gt;) − &lt;i&gt;W&lt;/i&gt;(&lt;i&gt;B&lt;/i&gt;(&lt;i&gt;T&lt;/i&gt;))&lt;br&gt;状态增益、归档刷新与预算终点目标&lt;br&gt;具有各自的参考状态" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=23;strokeWidth=1.5;fontColor=#20252A;spacing=9;rounded=0;fillColor=#F0ECF3;strokeColor=#756484;fontSize=21;" vertex="1" parent="recovery"><mxGeometry as="geometry" x="60" y="2030" width="580" height="165" /></mxCell><mxCell id="q0" value="" edge="1" parent="recovery" source="recovery_input" target="expand" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#353A40;strokeWidth=1.6;fontFamily=Microsoft YaHei;fontSize=20;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=9;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="q1" value="" edge="1" parent="recovery" source="expand" target="sketch" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#353A40;strokeWidth=1.6;fontFamily=Microsoft YaHei;fontSize=20;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=9;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="q2" value="" edge="1" parent="recovery" source="sketch" target="need" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#353A40;strokeWidth=1.6;fontFamily=Microsoft YaHei;fontSize=20;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=9;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="q3" value="是" edge="1" parent="recovery" source="need" target="kernel" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#353A40;strokeWidth=1.6;fontFamily=Microsoft YaHei;fontSize=20;labelBa