mlane;startSize=44;horizontal=1;rounded=1;fillColor=#ffffff;strokeColor=#333333;fontSize=22;align=left;spacingLeft=15;" vertex="1" parent="1"><mxGeometry as="geometry" x="20" y="800" width="1045" height="700" /></mxCell><mxCell id="lists" value="外部点与排序阻塞列表&lt;br&gt;&lt;i&gt;B&lt;/i&gt;&lt;sub&gt;v&lt;/sub&gt; = &lt;i&gt;N&lt;/i&gt;(&lt;i&gt;v&lt;/i&gt;) ∩ &lt;i&gt;S&lt;/i&gt;" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=20;strokeWidth=1.4;fontColor=#111111;rounded=0;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="screen"><mxGeometry as="geometry" x="30" y="90" width="220" height="100" /></mxCell><mxCell id="deficits" value="缺口与单点见证&lt;br&gt;&lt;i&gt;d&lt;/i&gt;&lt;sub&gt;v&lt;/sub&gt; = &lt;i&gt;W&lt;/i&gt;(&lt;i&gt;B&lt;/i&gt;&lt;sub&gt;v&lt;/sub&gt;) − &lt;i&gt;w&lt;/i&gt;&lt;sub&gt;v&lt;/sub&gt;" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=20;strokeWidth=1.4;fontColor=#111111;rounded=0;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="screen"><mxGeometry as="geometry" x="290" y="90" width="245" height="100" /></mxCell><mxCell id="enumerate" value="二跳枚举共享阻塞 pair&lt;br&gt;轮换 seed；去重" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=20;strokeWidth=1.4;fontColor=#111111;rounded=0;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="screen"><mxGeometry as="geometry" x="580" y="90" width="215" height="100" /></mxCell><mxCell id="prune" value="外部点兼容&lt;br&gt;且 &lt;i&gt;U&lt;/i&gt;&lt;sub&gt;ab&lt;/sub&gt; &amp;gt; 0？" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=20;strokeWidth=1.4;fontColor=#111111;rhombus;fillColor=#edf5fb;strokeColor=#2786b4;" vertex="1" parent="screen"><mxGeometry as="geometry" x="835" y="85" width="170" height="110" /></mxCell><mxCell id="exact" value="&lt;b&gt;精确共享阻塞增益&lt;/b&gt;&lt;br&gt;&lt;i&gt;g&lt;/i&gt;&lt;sub&gt;ab&lt;/sub&gt; = &lt;i&gt;W&lt;/i&gt;(&lt;i&gt;B&lt;/i&gt;&lt;sub&gt;a&lt;/sub&gt; ∩ &lt;i&gt;B&lt;/i&gt;&lt;sub&gt;b&lt;/sub&gt;) − &lt;i&gt;d&lt;/i&gt;&lt;sub&gt;a&lt;/sub&gt; − &lt;i&gt;d&lt;/i&gt;&lt;sub&gt;b&lt;/sub&gt;" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=20;strokeWidth=1.4;fontColor=#111111;rounded=0;fillColor=#edf5fb;strokeColor=#2786b4;" vertex="1" parent="screen"><mxGeometry as="geometry" x="555" y="280" width="385" height="110" /></mxCell><mxCell id="retain" value="保留最大正见证&lt;br&gt;固定并列规则" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=20;strokeWidth=1.4;fontColor=#111111;rounded=0;fillColor=#edf5fb;strokeColor=#2786b4;" vertex="1" parent="screen"><mxGeometry as="geometry" x="270" y="285" width="230" height="100" /></mxCell><mxCell id="return" value="返回见证与完整性标志&lt;br&gt;partial 时保留已得正下界" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=20;strokeWidth=1.4;fontColor=#111111;rounded=0;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="screen"><mxGeometry as="geometry" x="30" y="280" width="200" height="110" /></mxCell><mxCell id="boundformula" value="&lt;b&gt;安全 pair 上界&lt;/b&gt;&lt;br&gt;&lt;i&gt;U&lt;/i&gt;&lt;sub&gt;ab&lt;/sub&gt; = min(&lt;i&gt;W&lt;/i&gt;(&lt;i&gt;B&lt;/i&gt;&lt;sub&gt;a&lt;/sub&gt;), &lt;i&gt;W&lt;/i&gt;(&lt;i&gt;B&lt;/i&gt;&lt;sub&gt;b&lt;/sub&gt;)) − &lt;i&gt;d&lt;/i&gt;&lt;sub&gt;a&lt;/sub&gt; − &lt;i&gt;d&lt;/i&gt;&lt;sub&gt;b&lt;/sub&gt;" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=20;strokeWidth=1.4;fontColor=#111111;rounded=0;fillColor=#edf5fb;strokeColor=#2786b4;" vertex="1" parent="screen"><mxGeometry as="geometry" x="30" y="450" width="970" height="85" /></mxCell><mxCell id="certificate" value="&lt;b&gt;零证书范围&lt;/b&gt;&lt;br&gt;完整全 seed 扫描 + 全部单点增益 ≤ 0 + 无正见证&lt;br&gt;⇒ 此完整状态不存在插入至多两个外部点的改善交换" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=20;strokeWidth=1.4;fontColor=#111111;rounded=0;fillColor=#edf5fb;strokeColor=#2786b4;fontSize=19;" vertex="1" parent="screen"><mxGeometry as="geometry" x="30" y="560" width="970" height="105" /></mxCell><mxCell id="s0" value="" edge="1" parent="screen" source="lists" target="deficits" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s1" value="" edge="1" parent="screen" source="deficits" target="enumerate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s2" value="" edge="1" parent="screen" source="enumerate" target="prune" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s3" value="是" edge="1" parent="screen" source="prune" target="exact" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s4" value="否" edge="1" parent="screen" source="prune" target="enumerate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s5" value="" edge="1" parent="screen" source="exact" target="retain" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s6" value="" edge="1" parent="screen" source="retain" target="return" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="recovery" value="&lt;b&gt;正见证驱动的结构化恢复 / 算法 3&lt;/b&gt;" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=20;strokeWidth=1.4;fontColor=#111111;swimlane;startSize=44;horizontal=1;rounded=1;fillColor=#ffffff;strokeColor=#333333;fontSize=22;align=left;spacingLeft=15;" vertex="1" parent="1"><mxGeometry as="geometry" x="1100" y="800" width="1080" height="700" /></mxCell><mxCell id="seed" value="已核验正见证&lt;br&gt;已先送入历史归档" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=20;strokeWidth=1.4;fontColor=#111111;rounded=0;fillColor=#edf5fb;strokeColor=#2786b4;" vertex="1" parent="recovery"><mxGeometry as="geometry" x="30" y="90" width="210" height="100" /></mxCell><mxCell id="expand" value="沿已支付阻塞点扩展&lt;br&gt;保留负单点候选" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=20;strokeWidth=1.4;fontColor=#111111;rounded=0;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="recovery"><mxGeometry as="geometry" x="280" y="90" width="235" height="100" /></mxCell><mxCell id="sketch" value="&lt;b&gt;clique 成本分摊上界&lt;/b&gt;&lt;br&gt;与可行下界见证" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=20;strokeWidth=1.4;fontColor=#111111;rounded=0;fillColor=#fff3e8;strokeColor=#df7a2a;" vertex="1" parent="recovery"><mxGeometry as="geometry" x="555" y="90" width="230" height="100" /></mxCell><mxCell id="need" value="&lt;i&gt;U&lt;/i&gt; &amp;gt; 已有增益&lt;br&gt;且尚有时间？" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=20;strokeWidth=1.4;fontColor=#111111;rhombus;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="recovery"><mxGeometry as="geometry" x="825" y="85" width="205" height="110" /></mxCell><mxCell id="kernel" value="&lt;b&gt;完整边界 Kernel&lt;/b&gt;&lt;br&gt;外部点 + 全部受影响分量" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=20;strokeWidth=1.4;fontColor=#111111;rounded=0;fillColor=#fff3e8;strokeColor=#df7a2a;" vertex="1" parent="recovery"><mxGeometry as="geometry" x="795" y="295" width="240" height="110" /></mxCell><mxCell id="solve" value="&lt;b&gt;响应因子 + 结构消元&lt;/b&gt;&lt;br&gt;有界分支 / 可行回退" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=20;strokeWidth=1.4;fontColor=#111111;rounded=0;fillColor=#fff3e8;strokeColor=#df7a2a;" vertex="1" parent="recovery"><mxGeometry as="geometry" x="490" y="295" width="260" height="110" /></mxCell><mxCell id="lift" value="lift 并核验&lt;br&gt;仅保留超过已有见证的增益" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=20;strokeWidth=1.4;fontColor=#111111;rounded=0;fillColor=#fff3e8;strokeColor=#df7a2a;" vertex="1" parent="recovery"><mxGeometry as="geometry" x="225" y="295" width="225" height="110" /></mxCell><mxCell id="keep" value="返回已保留的&lt;br&gt;可行候选" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=20;strokeWidth=1.4;fontColor=#111111;rounded=0;fillColor=#edf5fb;strokeColor=#2786b4;" vertex="1" parent="recovery"><mxGeometry as="geometry" x="30" y="300" width="155" height="100" /></mxCell><mxCell id="objective" value="&lt;b&gt;固定状态上的联合交换&lt;/b&gt;&lt;br&gt;&lt;i&gt;S&lt;/i&gt;′ = (&lt;i&gt;S&lt;/i&gt; ∖ &lt;i&gt;N&lt;/i&gt;&lt;sub&gt;S&lt;/sub&gt;(&lt;i&gt;T&lt;/i&gt;)) ∪ &lt;i&gt;T&lt;/i&gt;&lt;br&gt;&lt;i&gt;g&lt;/i&gt;&lt;sub&gt;S&lt;/sub&gt;(&lt;i&gt;T&lt;/i&gt;) = &lt;i&gt;W&lt;/i&gt;(&lt;i&gt;T&lt;/i&gt;) − &lt;i&gt;W&lt;/i&gt;(&lt;i&gt;N&lt;/i&gt;&lt;sub&gt;S&lt;/sub&gt;(&lt;i&gt;T&lt;/i&gt;))" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=20;strokeWidth=1.4;fontColor=#111111;rounded=0;fillColor=#fff3e8;strokeColor=#df7a2a;" vertex="1" parent="recovery"><mxGeometry as="geometry" x="30" y="465" width="1000" height="100" /></mxCell><mxCell id="exception" value="deadline / 尺寸上限：保留已核验见证或其已有扩展结果。&lt;br&gt;状态增益、历史归档刷新与预算终点目标具有各自定义。" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=20;strokeWidth=1.4;fontColor=#111111;rounded=0;fillColor=none;strokeColor=none;fontSize=18;" vertex="1" parent="recovery"><mxGeometry as="geometry" x="30" y="585" width="1000" height="65" /></mxCell><mxCell id="q0" value="" edge="1" parent="recovery" source="seed" target="expand" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="q1" value="" edge="1" parent="recovery" source="expand" target="sketch" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="q2" value="" edge="1" parent="recovery" source="sketch" target="need" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="q3" value="是" edge="1" parent="recovery" source="need" target="kernel" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="q4" value="" edge="1" parent="recovery" source="kernel" target="solve" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="q5" value="" edge="1" parent="recovery" source="solve" target="lift" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="q6" value="" edge="1" parent="recovery" source="lift" target="keep" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="q_skip" value="否" edge="1" parent="recovery" source="need" target="keep" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="legend" value="R：下一次种群迭代 · 蓝色：pair 见证、证书与归档/状态反馈 · 橙色：结构化恢复&lt;br&gt;主搜索操作串行执行；下方两框分别展开算法 2 与算法 3。" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=20;strokeWidth=1.4;fontColor=#111111;rounded=0;fillColor=none;strokeColor=none;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="20" y="1530" width="2160" height="75" /></mxCell></root></mxGraphModel></diagram></mxfile>