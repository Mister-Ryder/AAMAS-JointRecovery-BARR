<mxfile host="draw.io" version="24.7.17"><diagram name="BARR pair-fusion" id="pair-fusion-zh"><mxGraphModel dx="2320" dy="2520" grid="0" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2400" pageHeight="2600" math="0" shadow="0" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;BARR pair-fusion：种群主循环与两个展开子算法&lt;/b&gt;" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=23;strokeWidth=1.5;fontColor=#20252A;spacing=9;rounded=0;fillColor=none;strokeColor=none;fontSize=32;" vertex="1" parent="1"><mxGeometry as="geometry" x="20" y="15" width="2260" height="65" /></mxCell><mxCell id="main" value="&lt;b&gt;算法 1 · 种群主循环&lt;/b&gt;" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=23;strokeWidth=1.5;fontColor=#20252A;spacing=9;swimlane;startSize=65;horizontal=1;rounded=0;fillColor=#ffffff;strokeColor=#555C63;fontSize=26;align=left;spacingLeft=24;" vertex="1" parent="1"><mxGeometry as="geometry" x="20" y="120" width="700" height="2300" /></mxCell><mxCell id="screen" value="&lt;b&gt;算法 2 · 共享阻塞 pair 筛选&lt;/b&gt;" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=23;strokeWidth=1.5;fontColor=#20252A;spacing=9;swimlane;startSize=65;horizontal=1;rounded=0;fillColor=#ffffff;strokeColor=#555C63;fontSize=26;align=left;spacingLeft=24;" vertex="1" parent="1"><mxGeometry as="geometry" x="800" y="120" width="700" height="2300" /></mxCell><mxCell id="recovery" value="&lt;b&gt;算法 3 · 结构化恢复&lt;/b&gt;" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=23;strokeWidth=1.5;fontColor=#20252A;spacing=9;swimlane;startSize=65;horizontal=1;rounded=0;fillColor=#ffffff;strokeColor=#555C63;fontSize=26;align=left;spacingLeft=24;" vertex="1" parent="1"><mxGeometry as="geometry" x="1580" y="120" width="700" height="2300" /></mxCell><mxCell id="start" value="开始" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=23;strokeWidth=1.5;fontColor=#20252A;spacing=9;ellipse;fillColor=#ffffff;strokeColor=#555C63;" vertex="1" parent="main"><mxGeometry as="geometry" x="265" y="100" width="170" height="55" /></mxCell><mxCell id="input" value="固定图 &lt;i&gt;G,w&lt;/i&gt; 与公共初解 &lt;i&gt;S&lt;/i&gt;&lt;sub&gt;0&lt;/sub&gt;" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=23;strokeWidth=1.5;fontColor=#20252A;spacing=9;shape=parallelogram;perimeter=parallelogramPerimeter;fillColor=#ffffff;strokeColor=#555C63;" vertex="1" parent="main"><mxGeometry as="geometry" x="150" y="190" width="400" height="80" /></mxCell><mxCell id="init" value="初始化 &lt;i&gt;P,S&lt;/i&gt;*、计时与缓存&lt;br&gt;&lt;i&gt;k&lt;/i&gt; ← 0；事件累计耗时 &lt;i&gt;H&lt;/i&gt; ← 0" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=23;strokeWidth=1.5;fontColor=#20252A;spacing=9;rounded=0;fillColor=#ffffff;strokeColor=#555C63;" vertex="1" parent="main"><mxGeometry as="geometry" x="150" y="310" width="400" height="95" /></mxCell><mxCell id="loop" value="&lt;i&gt;t &amp;lt; B&lt;/i&gt; 且&lt;br&gt;（未设 &lt;i&gt;K&lt;/i&gt; 或 &lt;i&gt;k &amp;lt; K&lt;/i&gt;）？" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=23;strokeWidth=1.5;fontColor=#20252A;spacing=9;rhombus;fillColor=#ffffff;strokeColor=#555C63;" vertex="1" parent="main"><mxGeometry as="geometry" x="180" y="465" width="340" height="130" /></mxCell><mxCell id="output" value="返回&lt;br&gt;可行历史最好解&lt;br&gt;&lt;i&gt;S&lt;/i&gt;*" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=23;strokeWidth=1.5;fontColor=#20252A;spacing=9;rounded=1;arcSize=40;fillColor=#ffffff;strokeColor=#555C63;fontSize=17;spacing=2;" vertex="1" parent="main"><mxGeometry as="geometry" x="550" y="475" width="140" height="110" /></mxCell><mxCell id="local" value="&lt;i&gt;k&lt;/i&gt; ← &lt;i&gt;k&lt;/i&gt; + 1；推进各个体局部搜索&lt;br&gt;候选送入归档；更新停滞轮数" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=23;strokeWidth=1.5;fontColor=#20252A;spacing=9;rounded=0;fillColor=#ffffff;strokeColor=#555C63;" vertex="1" parent="main"><mxGeometry as="geometry" x="150" y="665" width="400" height="100" /></mxCell><mxCell id="elig" value="预热、停滞轮数、&lt;br&gt;冷却与额度满足？" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=23;strokeWidth=1.5;fontColor=#20252A;spacing=9;rhombus;fillColor=#ffffff;strokeColor=#555C63;" vertex="1" parent="main"><mxGeometry as="geometry" x="180" y="825" width="340" height="125" /></mxCell><mxCell id="target" value="选择 elite 或轮转个体&lt;br&gt;每 4 次事件：可选融合 + 下降" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=23;strokeWidth=1.5;fontColor=#20252A;spacing=9;rounded=0;fillColor=#ffffff;strokeColor=#555C63;" vertex="1" parent="main"><mxGeometry as="geometry" x="150" y="1010" width="400" height="95" /></mxCell><mxCell id="cache" value="完整掩码&lt;br&gt;零证书缓存命中？" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=23;strokeWidth=1.5;fontColor=#20252A;spacing=9;rhombus;fillColor=#ffffff;strokeColor=#555C63;" vertex="1" parent="main"><mxGeometry as="geometry" x="180" y="1160" width="340" height="125" /></mxCell><mxCell id="scout" value="&lt;b&gt;调用 pair scout · 算法 2&lt;/b&gt;&lt;br&gt;状态 &lt;i&gt;S&lt;/i&gt;；deadline &lt;i&gt;D&lt;/i&gt;" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=23;strokeWidth=1.5;fontColor=#20252A;spacing=9;shape=process;fillColor=#E8F1EF;strokeColor=#356D70;" vertex="1" parent="main"><mxGeometry as="geometry" x="150" y="1345" width="400" height="85" /></mxCell><mxCell id="positive" value="存在正见证&lt;br&gt;&lt;i&gt;g &amp;gt; 0&lt;/i&gt;？" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=23;strokeWidth=1.5;fontColor=#20252A;spacing=9;rhombus;fillColor=#ffffff;strokeColor=#555C63;" vertex="1" parent="main"><mxGeometry as="geometry" x="180" y="1485" width="340" height="115" /></mxCell><mxCell id="archive" value="&lt;b&gt;先核验正见证并送入历史归档&lt;/b&gt;&lt;br&gt;&lt;i&gt;S&lt;/i&gt;&lt;sub&gt;T&lt;/sub&gt; = (&lt;i&gt;S&lt;/i&gt; ∖ &lt;i&gt;B&lt;/i&gt;(&lt;i&gt;T&lt;/i&gt;)) ∪ &lt;i&gt;T&lt;/i&gt;" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=23;strokeWidth=1.5;fontColor=#20252A;spacing=9;rounded=0;fillColor=#E8F1EF;strokeColor=#356D70;" vertex="1" parent="main"><mxGeometry as="geometry" x="150" y="1660" width="400" height="85" /></mxCell><mxCell id="refine" value="&lt;b&gt;调用结构化扩展 · 算法 3&lt;/b&gt;&lt;br&gt;保留已核验的正见证" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=23;strokeWidth=1.5;fontColor=#20252A;spacing=9;shape=process;fillColor=#F0ECF3;strokeColor=#756484;" vertex="1" parent="main"><mxGeometry as="geometry" x="150" y="1795" width="400" height="85" /></mxCell><mxCell id="feedback" value="核验保留候选并送入归档&lt;br&gt;重置当前局部搜索状态" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=23;strokeWidth=1.5;fontColor=#20252A;spacing=9;rounded=0;fillColor=#ffffff;strokeColor=#555C63;" vertex="1" parent="main"><mxGeometry as="geometry" x="150" y="1970" width="400" height="90" /></mxCell><mxCell id="charge" value="反馈可用融合态；计入事件耗时&lt;br&gt;&lt;i&gt;H&lt;/i&gt; ← &lt;i&gt;H&lt;/i&gt; + 本次事件墙时" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=23;strokeWidth=1.5;fontColor=#20252A;spacing=9;rounded=0;fillColor=#ffffff;strokeColor=#555C63;" vertex="1" parent="main"><mxGeometry as="geometry" x="150" y="2130" width="400" height="85" /