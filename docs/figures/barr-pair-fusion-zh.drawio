&gt;&lt;br&gt;算法 2" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=20;strokeWidth=1.4;fontColor=#111111;shape=process;fillColor=#edf5fb;strokeColor=#2786b4;" vertex="1" parent="main"><mxGeometry as="geometry" x="1500" y="235" width="205" height="85" /></mxCell><mxCell id="positive" value="存在&lt;br&gt;正见证？" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=20;strokeWidth=1.4;fontColor=#111111;rhombus;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="main"><mxGeometry as="geometry" x="1750" y="225" width="150" height="105" /></mxCell><mxCell id="r0" value="R" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=20;strokeWidth=1.4;fontColor=#111111;ellipse;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="main"><mxGeometry as="geometry" x="1960" y="250" width="55" height="55" /></mxCell><mxCell id="output" value="返回可行&lt;br&gt;历史最好解 &lt;i&gt;S&lt;/i&gt;*" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=20;strokeWidth=1.4;fontColor=#111111;shape=parallelogram;perimeter=parallelogramPerimeter;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="main"><mxGeometry as="geometry" x="495" y="490" width="175" height="90" /></mxCell><mxCell id="r1" value="R" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=20;strokeWidth=1.4;fontColor=#111111;ellipse;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="main"><mxGeometry as="geometry" x="935" y="465" width="55" height="55" /></mxCell><mxCell id="cachefeedback" value="融合态满足条件时&lt;br&gt;反馈至种群" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=20;strokeWidth=1.4;fontColor=#111111;rounded=0;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="main"><mxGeometry as="geometry" x="1295" y="70" width="175" height="85" /></mxCell><mxCell id="r2" value="R" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=20;strokeWidth=1.4;fontColor=#111111;ellipse;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="main"><mxGeometry as="geometry" x="1515" y="85" width="55" height="55" /></mxCell><mxCell id="witness" value="&lt;b&gt;核验正见证&lt;/b&gt;&lt;br&gt;先送入历史归档" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=20;strokeWidth=1.4;fontColor=#111111;rounded=0;fillColor=#edf5fb;strokeColor=#2786b4;" vertex="1" parent="main"><mxGeometry as="geometry" x="1740" y="485" width="180" height="95" /></mxCell><mxCell id="refine" value="&lt;b&gt;结构化扩展恢复&lt;/b&gt;&lt;br&gt;算法 3" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=20;strokeWidth=1.4;fontColor=#111111;shape=process;fillColor=#fff3e8;strokeColor=#df7a2a;" vertex="1" parent="main"><mxGeometry as="geometry" x="1485" y="485" width="205" height="95" /></mxCell><mxCell id="feedback" value="核验候选&lt;br&gt;归档 + 状态/种群反馈" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=20;strokeWidth=1.4;fontColor=#111111;rounded=0;fillColor=#edf5fb;strokeColor=#2786b4;" vertex="1" parent="main"><mxGeometry as="geometry" x="1220" y="485" width="210" height="95" /></mxCell><mxCell id="r3" value="R" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=20;strokeWidth=1.4;fontColor=#111111;ellipse;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="main"><mxGeometry as="geometry" x="1120" y="505" width="55" height="55" /></mxCell><mxCell id="budgetnote" value="完整事件计入 umbrella 额度；有界扩展中断时保留已核验的正见证。" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=20;strokeWidth=1.4;fontColor=#111111;rounded=0;fillColor=none;strokeColor=none;fontSize=18;" vertex="1" parent