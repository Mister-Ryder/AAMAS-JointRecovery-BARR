try as="geometry" x="30" y="90" width="210" height="100" /></mxCell><mxCell id="expand" value="Expand via paid blockers&lt;br&gt;retain negative singleton candidates" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=18;strokeWidth=1.4;fontColor=#111111;rounded=0;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="recovery"><mxGeometry as="geometry" x="280" y="90" width="235" height="100" /></mxCell><mxCell id="sketch" value="&lt;b&gt;Clique-cost upper bound&lt;/b&gt;&lt;br&gt;and feasible lower-bound witness" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=18;strokeWidth=1.4;fontColor=#111111;rounded=0;fillColor=#fff3e8;strokeColor=#df7a2a;" vertex="1" parent="recovery"><mxGeometry as="geometry" x="555" y="90" width="230" height="100" /></mxCell><mxCell id="need" value="&lt;i&gt;U&lt;/i&gt; &amp;gt; retained gain&lt;br&gt;and time remains?" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=18;strokeWidth=1.4;fontColor=#111111;rhombus;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="recovery"><mxGeometry as="geometry" x="825" y="85" width="205" height="110" /></mxCell><mxCell id="kernel" value="&lt;b&gt;Full-boundary Kernel&lt;/b&gt;&lt;br&gt;outsiders + affected components" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=18;strokeWidth=1.4;fontColor=#111111;rounded=0;fillColor=#fff3e8;strokeColor=#df7a2a;" vertex="1" parent="recovery"><mxGeometry as="geometry" x="795" y="295" width="240" height="110" /></mxCell><mxCell id="solve" value="&lt;b&gt;Response factors + elimination&lt;/b&gt;&lt;br&gt;bounded branch / feasible fallback" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=18;strokeWidth=1.4;fontColor=#111111;rounded=0;fillColor=#fff3e8;strokeColor=#df7a2a;" vertex="1" parent="recovery"><mxGeometry as="geometry" x="490" y="295" width="260" height="110" /></mxCell><mxCell id="lift" value="Lift and verify&lt;br&gt;keep only additional gain" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=18;strokeWidth=1.4;fontColor=#111111;rounded=0;fillColor=#fff3e8;strokeColor=#df7a2a;" vertex="1" parent="recovery"><mxGeometry as="geometry" x="225" y="295" width="225" height="110" /></mxCell><mxCell id="keep" value="Return retained&lt;br&gt;feasible candidate" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=18;strokeWidth=1.4;fontColor=#111111;rounded=0;fillColor=#edf5fb;strokeColor=#2786b4;" vertex="1" parent="recovery"><mxGeometry as="geometry" x="30" y="300" width="155" height="100" /></mxCell><mxCell id="objective" value="&lt;b&gt;Joint exchange on a fixed state&lt;/b&gt;&lt;br&gt;&lt;i&gt;S&lt;/i&gt;′ = (&lt;i&gt;S&lt;/i&gt; ∖ &lt;i&gt;N&lt;/i&gt;&lt;sub&gt;S&lt;/sub&gt;(&lt;i&gt;T&lt;/i&gt;)) ∪ &lt;i&gt;T&lt;/i&gt;&lt;br&gt;&lt;i&gt;g&lt;/i&gt;&lt;sub&gt;S&lt;/sub&gt;(&lt;i&gt;T&lt;/i&gt;) = &lt;i&gt;W&lt;/i&gt;(&lt;i&gt;T&lt;/i&gt;) − &lt;i&gt;W&lt;/i&gt;(&lt;i&gt;N&lt;/i&gt;&lt;sub&gt;S&lt;/sub&gt;(&lt;i&gt;T&lt;/i&gt;))" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=18;strokeWidth=1.4;fontColor=#111111;rounded=0;fillColor=#fff3e8;strokeColor=#df7a2a;" vertex="1" parent="recovery"><mxGeometry as="geometry" x="30" y="465" width="1000" height="100" /></mxCell><mxCell id="exception" value="Deadline / size cap: keep the verified seed or its retained refinement.&lt;br&gt;State gain, incumbent refresh and final-budget outcome are distinct quantities." style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=18;strokeWidth=1.4;fontColor=#111111;rounded=0;fillColor=none;strokeColor=none;fontSize=18;" vertex="1" parent="recovery"><mxGeometry as="geometry" x="30" y="585" wid