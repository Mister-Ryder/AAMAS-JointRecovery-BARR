/mxCell><mxCell id="completion" value="All seeds covered and singletons nonpositive:&lt;br&gt;complete ≤ 2; no positive witness: zero certificate&lt;br&gt;Deadline interruption: partial" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=21;strokeWidth=1.5;fontColor=#20252A;spacing=9;rounded=0;fillColor=#E8F1EF;strokeColor=#356D70;fontSize=21;" vertex="1" parent="screen"><mxGeometry as="geometry" x="110" y="1620" width="480" height="120" /></mxCell><mxCell id="screen_return" value="Return &lt;i&gt;T,g&lt;/i&gt;&lt;br&gt;+ completion flags" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=21;strokeWidth=1.5;fontColor=#20252A;spacing=9;shape=parallelogram;perimeter=parallelogramPerimeter;fillColor=#ffffff;strokeColor=#555C63;" vertex="1" parent="screen"><mxGeometry as="geometry" x="140" y="1800" width="420" height="85" /></mxCell><mxCell id="scope" value="&lt;b&gt;Analytical bound and certificate scope&lt;/b&gt;&lt;br&gt;&lt;i&gt;U&lt;/i&gt;&lt;sub&gt;ab&lt;/sub&gt; = min(&lt;i&gt;W&lt;/i&gt;(&lt;i&gt;B&lt;/i&gt;&lt;sub&gt;a&lt;/sub&gt;), &lt;i&gt;W&lt;/i&gt;(&lt;i&gt;B&lt;/i&gt;&lt;sub&gt;b&lt;/sub&gt;)) − &lt;i&gt;d&lt;/i&gt;&lt;sub&gt;a&lt;/sub&gt; − &lt;i&gt;d&lt;/i&gt;&lt;sub&gt;b&lt;/sub&gt;&lt;br&gt;Zero certificate covers ≤ 2 outsider insertions&lt;br&gt;at this exact state; partial does not certify zero." style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=21;strokeWidth=1.5;fontColor=#20252A;spacing=9;rounded=0;fillColor=#E8F1EF;strokeColor=#356D70;fontSize=21;" vertex="1" parent="screen"><mxGeometry as="geometry" x="60" y="2030" width="580" height="165" /></mxCell><mxCell id="s0" value="" edge="1" parent="screen" source="screen_input" target="lists" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#353A40;strokeWidth=1.6;fontFamily=Times New Roman;fontSize=20;labelBack